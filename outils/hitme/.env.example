# Required — Gemini analyzes the video
GEMINI_API_KEY=

# Required — at least key #1
YOUTUBE_API_KEY_1=

# Optional — keys 2-5 are used as fallbacks when earlier keys are exhausted.
# Tip: put each key in a separate Google Cloud project (quota is per-project).
YOUTUBE_API_KEY_2=
YOUTUBE_API_KEY_3=
YOUTUBE_API_KEY_4=
YOUTUBE_API_KEY_5=

# Required — Neon Postgres connection (pooled URL). Shared across collaborators.
# Get one from console.neon.tech → New Project → Connection details.
DATABASE_URL=

# Optional — Trend pickers search TikTok and Instagram through Apify, the one
# metered service here: every video returned is billed (free plan: $5 a month).
# apify.com → Settings → API & Integrations → Personal API token.
APIFY_TOKEN=
# Ceiling on what a single Apify run may bill, in USD (default 1).
# APIFY_MAX_USD_PER_RUN=1
