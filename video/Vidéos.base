filters:
  and:
    - file.inFolder("video")
    - file.ext == "md"
    - type == "longue" || type == "reel" || type == "trailer"
properties:
  quoi:
    displayName: Quoi
  etat:
    displayName: État
  tournage:
    displayName: Tournage
  sortie:
    displayName: Sortie
  type:
    displayName: Type
views:
  - type: table
    name: Tableau
    order:
      - file.name
      - quoi
      - etat
      - tournage
      - sortie
    sort:
      - property: sortie
        direction: ASC
  - type: cards
    name: Cartes
    order:
      - file.name
      - quoi
      - etat
      - sortie
    sort:
      - property: sortie
        direction: ASC
