# Ce dépôt est d'abord de la documentation : un coffre Obsidian. Le code vit dans outils/,
# qui a son propre .gitignore. Ici, ce qui ne se versionne nulle part.

# secrets : jamais publiés, où qu'ils soient
.env
.env*.local
*.pem

# dépendances et caches, où qu'ils soient : outils/, les projets HyperFrames dans video/
node_modules/
.next/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store

# Claude Code : réglages locaux de la machine
.claude/settings.local.json

# caches générés par le serveur de preview HyperFrames
.thumbnails/
.waveform-cache/

# clips détourés : trop lourds pour git, ils se régénèrent
video/*/assets/detoure/

# obsidian : l'état de fenêtre et la corbeille ne se versionnent pas, la config oui
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace/
.obsidian/cache
.trash/
